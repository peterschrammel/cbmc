Test
--function Test.main -cp `../../../../scripts/format_classpath.sh target/classes ../../../lib/java-models-library/target/core-models.jar ../../../lib/java-models-library/target/cprover-api.jar` --show-goto-functions --java-cp-include-files '([^/]*|org/cprover/.*|java/lang/.*)\.class'
